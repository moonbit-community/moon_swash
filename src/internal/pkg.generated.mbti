pub fn[T : RawFont] Vhea::from_font(T) -> Self?
pub fn Vhea::line_gap(Self) -> Int32
pub fn Vhea::max_advance(Self) -> UInt32
pub fn Vhea::num_long_metrics(Self) -> UInt32

// Type aliases
pub type RawTag = UInt32

// Traits
pub(open) trait RawFont {
  fn data(Self) -> Bytes
  fn offset(Self) -> Int32
}
